# Copy to .env and edit. .env is gitignored — keep your passphrase out of git.

# Account directory mounted read-only into the HBase container. It must contain
# your keys and the *.user.properties returned by your org admin.
# Absolute path required (~ is not expanded); ${HOME} works.
ALTASTATA_ACCOUNT_DIR=${HOME}/.altastata/accounts/google.rsa.alice

# Passphrase of that account's private key.
ALTASTATA_PASSWORD=change-me

# HBase root on AltaStata storage. Use a fresh name for a fresh cluster; reuse
# the same name (together with data/hbase-wals) to reopen existing tables.
HBASE_ROOTDIR=altastata:///hbase_janusgraph
