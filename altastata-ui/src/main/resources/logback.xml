<configuration>
    <!-- Console Appender with Duplicate Filter -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="ch.qos.logback.core.filter.DuplicateMessageFilter">
            <!-- Cache size for duplicate detection -->
            <cacheSize>100</cacheSize>
            <!-- Allow showing the message only once -->
            <allowedRepetitions>0</allowedRepetitions>
        </filter>
        <encoder>
            <pattern>%cyan(%d{yyyy/MM/dd HH:mm:ss.S}) %highlight(%-5level) %gray([%thread]) %magenta(%-5level %logger) - %msg%n</pattern>
        </encoder>
    </appender>

    <timestamp key="timestamp" datePattern="yyyyMMdd"/>

    <!-- File Appender — same path as AltaStataConfig.initLogbackConfigPath("application") -->
    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>${user.home:-.}/.altastata/application/logs/logfile-${timestamp}.log</file>
        <encoder>
            <pattern>%d{yyyy/MM/dd HH:mm:ss.S} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Logger Configuration -->
    <logger name="com.altastata.ui" level="INFO"/>
    <logger name="com.altastata.api.accountsetup" level="INFO"/>
    <logger name="com.altastata" level="WARN"/>

    <!-- Set SecureCloudEventProcessor to WARN to reduce frequency -->
    <logger name="com.altastata.filesystem.securecloud.SecureCloudEventProcessor" level="WARN"/>

    <!-- Third-party Logger Configuration -->
    <logger name="org.apache.http" level="ERROR"/>
    <logger name="software.amazon" level="ERROR"/>
    <logger name="software.amazon.awssdk" level="ERROR"/>

    <!-- Root Logger -->
    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
